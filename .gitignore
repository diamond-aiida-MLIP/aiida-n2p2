# Python
__pycache__/
*.py[cod]
*.egg*
*.swo
*.swp
**/.ipynb_checkpoints/
~*
*~

# IDE / OS
.project
.DS_Store
.vscode

# Build / test tooling
build/
dist/
pip-wheel-metadata/
.tox/
.coverage
.pytest_cache/

# AiiDA node dumps and scheduler artifacts
dump-*/
**/.aiida_node_metadata.yaml
**/.aiida/
**/_aiidasubmit.sh
**/_scheduler-*.txt

# n2p2 run outputs (keep test fixtures — see exceptions below)
*.out
*.histo
*.log
nnp-scaling.log.*
nnp-symfunc.log*
learning-curve*.out
weights.*.out
sf.*.*
neighbors.*
function.data
scaling.data
*.lammpstrj

# Office / editor lock files
.~lock.*

# Generated figures in examples
examples/**/*.png
examples/**/*.jpg

# Local helper scripts (not part of the plugin API)
examples/1.Al/plot-symfuncs.py

# ---------------------------------------------------------------------------
# Boron example: ship scripts + small inputs only (not local research data)
# ---------------------------------------------------------------------------
examples/1.Boron/analysis/
examples/1.Boron/optimization/
examples/1.Boron/output_*/
examples/1.Boron/dump-*/
examples/1.Boron/input.data
